---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 680px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3em 1em 4em 1em;
			}

			.page-header {
				border-bottom: 1px solid var(--border);
				padding-bottom: 1.5em;
				margin-bottom: 2em;
			}

			.page-title {
				font-size: 1.1em;
				font-weight: 600;
				color: var(--text);
				margin: 0 0 0.3em 0;
				letter-spacing: -0.01em;
			}

			.page-subtitle {
				font-size: 0.9em;
				color: var(--text-light);
				margin: 0;
				opacity: 0.7;
			}

			/* Category filter */
			.filter-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-bottom: 2.5em;
			}

			.filter-btn {
				padding: 0.35em 0.9em;
				border-radius: 999px;
				border: 1px solid var(--border);
				background: transparent;
				color: var(--text-light);
				cursor: pointer;
				font-size: 0.82em;
				font-family: "Georgia", serif;
				font-weight: 400;
				letter-spacing: 0;
				text-transform: none;
				transition: all 0.2s ease;
			}

			.filter-btn:hover {
				border-color: var(--text);
				color: var(--text);
				background: transparent;
			}

			.filter-btn.active {
				background: var(--text);
				color: var(--background);
				border-color: var(--text);
			}

			/* Post list */
			.posts-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-item {
				display: flex;
				align-items: flex-start;
				gap: 1.5em;
				padding: 1.5em 0;
				border-bottom: 1px solid var(--border);
				transition: opacity 0.25s ease, transform 0.25s ease;
			}

			.post-item:first-child {
				padding-top: 0;
			}

			.post-body {
				flex: 1;
				min-width: 0;
			}

			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin-bottom: 0.5em;
			}

			.post-category {
				font-size: 0.75em;
				font-weight: 600;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				opacity: 0.7;
			}

			.post-date {
				font-size: 0.78em;
				color: var(--text-light);
				opacity: 0.55;
			}

			.meta-sep {
				color: var(--border);
				font-size: 0.75em;
			}

			.post-title {
				font-size: 1.15em;
				font-weight: 600;
				color: var(--text);
				line-height: 1.3;
				margin: 0 0 0.4em 0;
				letter-spacing: -0.02em;
				transition: color 0.2s ease;
			}

			.post-description {
				font-size: 0.88em;
				color: var(--text-light);
				line-height: 1.55;
				margin: 0;
				opacity: 0.75;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-top: 0.7em;
			}

			.post-tag {
				font-size: 0.75em;
				color: var(--text-light);
				opacity: 0.6;
			}

			.post-tag::before {
				content: "·";
				margin-right: 0.4em;
			}

			.post-thumb {
				flex-shrink: 0;
				width: 110px;
				height: 74px;
				object-fit: cover;
				border-radius: 4px;
				border: none;
				filter: grayscale(15%);
				transition: filter 0.3s ease;
			}

			.post-thumb:hover {
				filter: grayscale(0%);
				box-shadow: none;
			}

			.post-item a {
				display: flex;
				align-items: flex-start;
				gap: 1.5em;
				text-decoration: none;
				width: 100%;
			}

			.post-item a:hover .post-title {
				color: var(--c6);
			}

			.post-item a:hover .post-thumb {
				filter: grayscale(0%);
			}

			@media (max-width: 560px) {
				.post-thumb {
					width: 80px;
					height: 56px;
				}

				.post-title {
					font-size: 1em;
				}

				.post-description {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<div class="page-header">
				<h1 class="page-title">Jack Su's Blog</h1>
				<p class="page-subtitle">Writing on technology, algorithms, and everything in between.</p>
			</div>

			<div class="filter-row">
				<button class="filter-btn active" data-category="all">All</button>
				{CATEGORIES.map((category) => (
					<button class="filter-btn" data-category={category}>{category}</button>
				))}
			</div>

			<ul class="posts-list" id="posts-list">
				{posts.map((post) => (
					<li class="post-item" data-category={post.data.category || 'uncategorized'}>
						<a href={`/blog/${post.slug}/`}>
							<div class="post-body">
								<div class="post-meta">
									{post.data.category && (
										<span class="post-category">{post.data.category}</span>
									)}
									{post.data.category && <span class="meta-sep">·</span>}
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
								<h2 class="post-title">{post.data.title}</h2>
								{post.data.description && (
									<p class="post-description">{post.data.description}</p>
								)}
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="post-tags">
										{post.data.tags.map((tag) => (
											<span class="post-tag">{tag}</span>
										))}
									</div>
								)}
							</div>
							{post.data.heroImage && (
								<img class="post-thumb" src={post.data.heroImage} alt="" />
							)}
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />

		<script>
			const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
			const postItems = document.querySelectorAll<HTMLLIElement>('#posts-list .post-item');

			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					const cat = btn.dataset.category;
					filterBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');

					postItems.forEach(item => {
						const match = cat === 'all' || item.dataset.category === cat;
						item.style.display = match ? '' : 'none';
					});
				});
			});
		</script>
	</body>
</html>
