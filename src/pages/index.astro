---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CATEGORIES } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 680px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 4em 1em 5em 1em;
			}

			/* ---- Author brand header ---- */
			.author {
				display: flex;
				align-items: center;
				gap: 1.1em;
				margin-bottom: 2.5em;
			}

			.author-avatar {
				flex-shrink: 0;
				width: 64px;
				height: 64px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				background: var(--text);
				color: var(--background);
				font-family: var(--font-sans);
				font-weight: 600;
				font-size: 1.5em;
				letter-spacing: -0.02em;
				border: none;
				overflow: hidden;
			}

			.author-avatar img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border: none;
				border-radius: 0;
				filter: none;
			}

			.author-info {
				min-width: 0;
			}

			.author-name {
				font-family: var(--font-serif);
				font-size: 1.5em;
				font-weight: 700;
				line-height: 1.1;
				letter-spacing: -0.03em;
				margin: 0 0 0.25em 0;
				color: var(--text);
			}

			.author-bio {
				font-family: var(--font-sans);
				font-size: 0.9em;
				color: var(--text-light);
				line-height: 1.5;
				margin: 0 0 0.5em 0;
				opacity: 0.8;
			}

			.author-social {
				display: flex;
				gap: 1em;
			}

			.author-social a {
				font-family: var(--font-sans);
				font-size: 0.8em;
				font-weight: 500;
				color: var(--text-light);
				opacity: 0.7;
				text-decoration: none;
			}

			.author-social a:hover {
				opacity: 1;
				color: var(--text);
				text-decoration: underline;
			}

			.section-divider {
				border: none;
				border-top: 1px solid var(--border);
				margin: 0 0 2em 0;
			}

			/* Category filter */
			.filter-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-bottom: 2.5em;
			}

			.filter-btn {
				padding: 0.4em 1em;
				border-radius: 999px;
				border: 1px solid var(--border);
				background: transparent;
				color: var(--text-light);
				cursor: pointer;
				font-size: 0.82em;
				font-family: var(--font-sans);
				font-weight: 500;
				letter-spacing: 0;
				text-transform: none;
			}

			.filter-btn:hover {
				border-color: var(--text);
				color: var(--text);
				background: transparent;
			}

			.filter-btn.active {
				background: var(--text);
				color: var(--background);
				border-color: var(--text);
			}

			/* Post list */
			.posts-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.post-item {
				display: flex;
				align-items: flex-start;
				gap: 2em;
				padding: 2em 0;
				border-bottom: 1px solid var(--border);
			}

			.post-item:first-child {
				padding-top: 0;
			}

			.post-body {
				flex: 1;
				min-width: 0;
			}

			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin-bottom: 0.6em;
			}

			.post-category {
				font-family: var(--font-sans);
				font-size: 0.72em;
				font-weight: 600;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				opacity: 0.7;
			}

			.post-date {
				font-family: var(--font-sans);
				font-size: 0.76em;
				color: var(--text-light);
				opacity: 0.55;
			}

			.meta-sep {
				color: var(--border);
				font-size: 0.75em;
			}

			.post-title {
				font-family: var(--font-serif);
				font-size: 1.42em;
				font-weight: 700;
				color: var(--text);
				line-height: 1.28;
				margin: 0 0 0.45em 0;
				letter-spacing: -0.02em;
			}

			.post-description {
				font-family: var(--font-serif);
				font-size: 1em;
				color: var(--text-light);
				line-height: 1.6;
				margin: 0;
				opacity: 0.75;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				margin-top: 0.9em;
			}

			.post-tag {
				font-family: var(--font-sans);
				font-size: 0.74em;
				color: var(--text-light);
				opacity: 0.6;
			}

			.post-tag::before {
				content: "·";
				margin-right: 0.4em;
			}

			.post-thumb {
				flex-shrink: 0;
				width: 130px;
				height: 90px;
				object-fit: cover;
				border-radius: 6px;
				border: none;
				filter: grayscale(15%);
			}

			.post-thumb:hover {
				filter: grayscale(0%);
				box-shadow: none;
			}

			.post-item a {
				display: flex;
				align-items: flex-start;
				gap: 2em;
				text-decoration: none;
				width: 100%;
			}

			.post-item a:hover .post-title {
				color: var(--c6);
			}

			.post-item a:hover .post-thumb {
				filter: grayscale(0%);
			}

			@media (max-width: 560px) {
				.author {
					gap: 0.9em;
				}
				.author-avatar {
					width: 52px;
					height: 52px;
					font-size: 1.2em;
				}
				.author-name {
					font-size: 1.3em;
				}
				.post-thumb {
					width: 90px;
					height: 64px;
				}

				.post-title {
					font-size: 1.2em;
				}

				.post-description {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<div class="author">
				<div class="author-avatar"><img src="/blog-placeholder-about.jpeg" alt="Jack Su" /></div>
				<div class="author-info">
					<h1 class="author-name">Jack Su</h1>
					<p class="author-bio">Writing on technology, algorithms, and everything in between.</p>
					<div class="author-social">
						<a href="https://github.com/JackSuuu" target="_blank" rel="noopener">GitHub</a>
						<a href="https://medium.com/@18922443765jack" target="_blank" rel="noopener">Medium</a>
						<a href="https://www.instagram.com/jacksuuuuu/" target="_blank" rel="noopener">Instagram</a>
					</div>
				</div>
			</div>

			<hr class="section-divider" />

			<div class="filter-row">
				<button class="filter-btn active" data-category="all">All</button>
				{CATEGORIES.map((category) => (
					<button class="filter-btn" data-category={category}>{category}</button>
				))}
			</div>

			<ul class="posts-list" id="posts-list">
				{posts.map((post) => (
					<li class="post-item" data-category={post.data.category || 'uncategorized'}>
						<a href={`/blog/${post.slug}/`}>
							<div class="post-body">
								<div class="post-meta">
									{post.data.category && (
										<span class="post-category">{post.data.category}</span>
									)}
									{post.data.category && <span class="meta-sep">·</span>}
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</div>
								<h2 class="post-title">{post.data.title}</h2>
								{post.data.description && (
									<p class="post-description">{post.data.description}</p>
								)}
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="post-tags">
										{post.data.tags.map((tag) => (
											<span class="post-tag">{tag}</span>
										))}
									</div>
								)}
							</div>
							{post.data.heroImage && (
								<img class="post-thumb" src={post.data.heroImage} alt="" />
							)}
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />

		<script>
			const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
			const postItems = document.querySelectorAll<HTMLLIElement>('#posts-list .post-item');

			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					const cat = btn.dataset.category;
					filterBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');

					postItems.forEach(item => {
						const match = cat === 'all' || item.dataset.category === cat;
						item.style.display = match ? '' : 'none';
					});
				});
			});
		</script>
	</body>
</html>
