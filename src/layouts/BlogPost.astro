---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags, category } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 680px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3em 1em 5em 1em;
			}

			.back-link {
				display: inline-block;
				font-family: var(--font-sans);
				font-size: 0.82em;
				font-weight: 500;
				color: var(--text-light);
				opacity: 0.6;
				margin-bottom: 2.5em;
				text-decoration: none;
			}

			.back-link:hover {
				opacity: 1;
				color: var(--text);
			}

			.post-header {
				margin-bottom: 2em;
				padding-bottom: 1.5em;
				border-bottom: 1px solid var(--border);
			}

			.post-meta {
				display: flex;
				align-items: center;
				gap: 0.6em;
				margin-bottom: 0.8em;
			}

			.post-category {
				font-family: var(--font-sans);
				font-size: 0.72em;
				font-weight: 600;
				color: var(--text-light);
				text-transform: uppercase;
				letter-spacing: 0.08em;
				opacity: 0.7;
			}

			.meta-sep {
				color: var(--border);
				font-size: 0.75em;
			}

			.post-date {
				font-family: var(--font-sans);
				font-size: 0.76em;
				color: var(--text-light);
				opacity: 0.55;
			}

			.post-title {
				font-family: var(--font-serif);
				font-size: 2em;
				font-weight: 700;
				line-height: 1.2;
				letter-spacing: -0.04em;
				color: var(--text);
				margin: 0 0 0.5em 0;
			}

			.post-description {
				font-family: var(--font-serif);
				font-size: 1em;
				color: var(--text-light);
				line-height: 1.6;
				margin: 0;
				opacity: 0.7;
			}

			.last-updated {
				font-family: var(--font-sans);
				font-size: 0.76em;
				font-style: italic;
				color: var(--text-light);
				opacity: 0.5;
				margin-top: 0.4em;
			}

			.hero-image {
				margin-bottom: 2em;
			}

			.hero-image img {
				width: 100%;
				height: auto;
				border-radius: 6px;
				border: none;
				display: block;
			}

			.prose {
				color: var(--text-light);
				line-height: 1.75;
				font-size: 1.02em;
			}

			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5em;
				margin-top: 3em;
				padding-top: 1.5em;
				border-top: 1px solid var(--border);
			}

			.post-tag {
				font-family: var(--font-sans);
				font-size: 0.76em;
				color: var(--text-light);
				opacity: 0.55;
			}

			.post-tag::before {
				content: "·";
				margin-right: 0.4em;
			}

			@media (max-width: 720px) {
				main {
					padding: 2em 1.25em 4em 1.25em;
				}

				.post-title {
					font-size: 1.5em;
				}

				.post-description {
					font-size: 1em;
				}
			}
		</style>
	</head>

	<body>
		<main>
			<a class="back-link" href="/">← All posts</a>

			{heroImage && (
				<div class="hero-image">
					<img src={heroImage} alt="" />
				</div>
			)}

			<div class="post-header">
				<div class="post-meta">
					{category && <span class="post-category">{category}</span>}
					{category && <span class="meta-sep">·</span>}
					<span class="post-date"><FormattedDate date={pubDate} /></span>
					{updatedDate && (
						<span class="meta-sep">·</span>
						<span class="last-updated">Updated <FormattedDate date={updatedDate} /></span>
					)}
				</div>
				<h1 class="post-title">{title}</h1>
				{description && <p class="post-description">{description}</p>}
			</div>

			<div class="prose">
				<slot />
			</div>

			{tags && tags.length > 0 && (
				<div class="post-tags">
					{tags.map((tag) => (
						<span class="post-tag">{tag}</span>
					))}
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>
